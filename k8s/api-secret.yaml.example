# 실제 apply 시 이 파일을 복사해서 k8s/api-secret.yaml로 만들고 실제 값 채운 뒤
# kubectl apply -f k8s/api-secret.yaml 로 먼저 적용 (api.yaml보다 먼저 적용해야 함)
# 이 파일 자체(.example)는 git에 커밋되지만, 실제 값이 든 api-secret.yaml은 .gitignore 처리할 것
apiVersion: v1
kind: Secret
metadata:
  name: shopmall-secrets
type: Opaque
stringData:
  DB_HOST: "<RDS_ENDPOINT>"       # terraform output rds_endpoint 값
  DB_PORT: "3306"
  DB_USER: "admin"
  DB_PASSWORD: "<terraform.tfvars의 db_password와 동일>"
  DB_NAME: "shopmall"
  JWT_SECRET: "<원하는 임의의 긴 문자열>"
  ANTHROPIC_API_KEY: "<발급받은 Claude API 키>"
